#!/usr/bin/env bash
# Apply a test configuration without changing the default boot generation.
# Usage: qrebuild [nixos-rebuild args]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "Testing NixOS configuration (this activates services, not a dry run)..."
# Keep the installed client compatible with the running systemd during upgrades.
sudo /run/current-system/sw/bin/nixos-rebuild test --no-reexec --flake "$SCRIPT_DIR#hp-ara" "$@"

echo "Test activation complete; the default boot configuration was not changed."
